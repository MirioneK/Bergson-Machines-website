<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Nie przepisywuj endpointów backendu - mają trafić do Node/Passenger
  RewriteRule ^api(/|$) - [L]

  RewriteRule ^pl/(osprzet/)?(hydraulic-hammer|mlot-hydrauliczny)/?$ /pl/osprzet [R=301,L]
  RewriteRule ^en/(accessories/)?hydraulic-hammer/?$ /en/accessories [R=301,L]
  RewriteRule ^ua/(accessories/)?hydraulic-hammer/?$ /ua/accessories [R=301,L]
  RewriteRule ^(hydraulic-hammer|mlot-hydrauliczny)/?$ /pl/osprzet [R=301,L]

  RewriteRule ^index\.html$ - [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback dla React SPA
  RewriteRule . /index.html [L]
</IfModule>
